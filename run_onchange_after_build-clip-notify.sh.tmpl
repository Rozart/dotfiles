{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# clip-notify.plist hash: {{ include "dot_local/share/clip-notify/clip-notify.plist" | sha256sum }}

# Builds the signed .shortcut that clip-receive calls to post arrival
# notifications. Importing it is the one step that cannot be scripted: the
# shortcuts CLI has run/list/view/sign and no create or import verb, and the
# Core Data store behind Shortcuts.app is not safe to write by hand.
#
# This never opens the import sheet on its own -- it prints the command so the
# import stays a deliberate choice.

dir="$HOME/.local/share/clip-notify"
src="$dir/clip-notify.plist"
out="$dir/clip-notify.shortcut"
# The .shortcut extension is load-bearing: `shortcuts sign` rejects an input
# without it ("isn't in the correct format"), whatever the file contains.
tmp="$dir/clip-notify.unsigned.shortcut"

if [ ! -f "$src" ]; then
	echo "clip-notify: $src missing, skipping"
	exit 0
fi

plutil -convert binary1 -o "$tmp" "$src" || exit 1
rm -f "$out"
if ! shortcuts sign --mode anyone -i "$tmp" -o "$out"; then
	rm -f "$tmp"
	echo "clip-notify: signing failed"
	exit 1
fi
rm -f "$tmp"

if shortcuts list 2>/dev/null | grep -qx clip-notify; then
	echo "clip-notify shortcut rebuilt; re-import to pick up changes: open $out"
else
	echo ">>> clipboard notifications need the shortcut imported (one click): open $out"
fi
{{ end -}}
