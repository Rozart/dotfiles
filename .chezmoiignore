# Machine-local state fish rewrites on its own (init counter, and the
# key-binding var it migrated out of universal scope in 4.3). The plugin list
# it also holds is tracked declaratively in fish_plugins.
.config/fish/fish_variables

# Karabiner rewrites this file on every UI change (and adds machine-specific
# device ids). Keep a versioned snapshot in git, but never let apply clobber
# the live file. Because it's ignored, `chezmoi add`/`re-add` won't update the
# snapshot — re-snapshot after edits with a plain copy, then commit:
#   cp ~/.config/karabiner/karabiner.json \
#      ~/.local/share/chezmoi/dot_config/karabiner/private_karabiner.json
.config/karabiner/karabiner.json

# Ignore Mac-specific SSH keys on non-darwin systems
{{- if ne .chezmoi.os "darwin" }}
Library
# mounts the servers' SMB shares; only ever runs on a Mac client
.local/bin/mount-servers
# receives remote copies into this Mac's clipboard; Mac-side only
.local/bin/clip-receive
.ssh/proxmox.pub
.ssh/dev-station.pub
.ssh/docker-host.pub
.ssh/media-host.pub
.ssh/proxmox-tailscale-lxc.pub
{{- end }}

# Ignore systemd-related files on macOS
{{- if eq .chezmoi.os "darwin" }}
.config/glances/glances.service
# native pbcopy/pbpaste exist on macOS; the shims are for Linux servers
.config/fish/functions/pbcopy.fish
.config/fish/functions/pbpaste.fish
# sends copies *to* this Mac through the ssh tunnel; pointless on the Mac itself
.local/bin/clip-copy
{{- end }}
