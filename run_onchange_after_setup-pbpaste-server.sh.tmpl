{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -e

# pbpaste-server.plist hash: {{ include "Library/LaunchAgents/dev.rozart.pbpaste-server.plist" | sha256sum }}
# pbcopy-server.plist hash: {{ include "Library/LaunchAgents/dev.rozart.pbcopy-server.plist" | sha256sum }}
# open-server.plist hash: {{ include "Library/LaunchAgents/dev.rozart.open-server.plist" | sha256sum }}

# Exit non-zero so chezmoi does not record this script as run: a plain skip
# here (socat arriving later via brew bundle) leaves the agents unloaded
# forever, and the clipboard tunnel then fails silently.
if [ ! -x /opt/homebrew/bin/socat ]; then
	echo "socat not installed (brew bundle), clipboard server setup deferred"
	exit 1
fi

for name in pbpaste-server pbcopy-server open-server; do
	launchctl bootout "gui/$(id -u)/dev.rozart.$name" 2>/dev/null || true
	launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.rozart.$name.plist"
done

echo "tunnel launchd agents loaded (pbpaste 127.0.0.1:2489, pbcopy 127.0.0.1:2490, open 127.0.0.1:2491)"
{{ end -}}
