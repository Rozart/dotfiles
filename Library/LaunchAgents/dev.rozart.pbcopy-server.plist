<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.rozart.pbcopy-server</string>
	<!-- Writes anything sent to localhost:2490 into the Mac clipboard. SSH
	     RemoteForward (see ~/.ssh/config) exposes it on remote hosts so
	     copies arrive deterministically instead of via OSC 52 escape
	     sequences (size limits, per-hop terminal handling).

	     Replies "OK" once pbcopy has exited successfully. The sender cannot
	     learn this any other way: the remote sshd accepts the forwarded
	     connection before the Mac end is consulted, so nc exits 0 even when
	     this agent is dead. clip-copy waits for the ack to decide between
	     "landed" (notify) and "tunnel down" (OSC 52 fallback).

	     SYSTEM: rather than EXEC: because the && needs a shell. -->
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/socat</string>
		<string>TCP-LISTEN:2490,bind=127.0.0.1,fork,reuseaddr</string>
		<string>SYSTEM:/usr/bin/pbcopy &amp;&amp; printf OK</string>
	</array>
	<!-- launchd starts agents with no locale at all, and pbcopy then reads its
	     input as Mac OS Roman: every UTF-8 sequence becomes garbage characters
	     in the pasteboard, so Cmd-V pasted mojibake into every Mac app. The
	     tunnel round-trip hid it, because the pbpaste server reversed the same
	     wrong mapping on the way back out. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>LC_CTYPE</key>
		<string>UTF-8</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
