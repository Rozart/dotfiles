<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.rozart.pbpaste-server</string>
	<!-- Serves the Mac clipboard on localhost:2489. SSH RemoteForward (see
	     ~/.ssh/config) exposes it on remote hosts so nvim/fish can paste the
	     real Mac clipboard through tmux, where OSC 52 paste can't reach. -->
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/socat</string>
		<string>TCP-LISTEN:2489,bind=127.0.0.1,fork,reuseaddr</string>
		<string>EXEC:/usr/bin/pbpaste</string>
	</array>
	<!-- launchd starts agents with no locale at all, and pbpaste then encodes
	     the pasteboard as Mac OS Roman instead of UTF-8. Must stay in step with
	     the pbcopy server: both wrong cancelled out over the tunnel, so fixing
	     only one end would start corrupting remote pastes. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>LC_CTYPE</key>
		<string>UTF-8</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
