<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.rozart.smb-mounts</string>
	<!-- Mounts /home/rozart from dev-station, docker-host and media-host as
	     SMB volumes in /Volumes. Runs as the user so NetFS can read the
	     login Keychain for credentials; see ~/.local/bin/mount-servers.
	     The network-change trigger is what re-mounts them after rejoining
	     the LAN without needing to log out and back in. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/rozart/.local/bin/mount-servers</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.notifyd.matching</key>
		<dict>
			<key>network-change</key>
			<dict>
				<key>Name</key>
				<string>com.apple.system.config.network_change</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
