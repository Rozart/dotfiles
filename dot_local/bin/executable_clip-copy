#!/bin/bash
# Copies stdin to the Mac clipboard over the ssh-forwarded tunnel (port 2490,
# served by the dev.rozart.pbcopy-server launchd agent). Single writer for every
# remote copy path: the fish pbcopy function, tmux's copy-command, and nvim's
# clipboard provider all call this.
#
# The server replies "OK" once the clipboard is actually set, and that ack is
# the whole point. nc's exit status is worthless here: the remote sshd accepts
# the forwarded connection before the Mac end is consulted, so nc reports
# success even when the agent on the other side is dead. Waiting for the ack is
# what makes the OSC 52 fallback actually trigger.
#
# The arrival notification is posted on the Mac by clip-receive, not from here,
# because no terminal escape sequence on that machine produces one -- Ghostty
# ignores both OSC 9 and OSC 777 in practice. Hence the origin header below:
# it is the only way the Mac can tell which host copied.

set -u

readonly PORT=2490

# Trailing newlines are significant for line-wise yanks; $() would eat them.
data=$(cat; printf x)
data=${data%x}

has_tty() {
	: >/dev/tty 2>/dev/null
}

# tmux understands OSC 52 natively and re-emits it to the outer terminal, so
# this needs no passthrough wrapper.
fallback() {
	has_tty || return 1
	printf '\033]52;c;%s\a' "$(printf '%s' "$data" | base64 | tr -d '\n')" >/dev/tty
}

if ! command -v nc >/dev/null 2>&1; then
	fallback
	echo "clip-copy: nc not installed, copied via OSC 52 instead" >&2
	exit 0
fi

# \037 (unit separator) keeps the header from ever colliding with real content.
# An un-updated host sends no header and simply shows up as "unknown".
send() {
	printf '\037clip-origin:%s\037\n' "$(hostname -s)"
	printf '%s' "$data"
}

if [ "$(send | nc -N -w 1 127.0.0.1 "$PORT" 2>/dev/null)" = OK ]; then
	exit 0
fi

fallback
echo "clip-copy: no ack from 127.0.0.1:$PORT, clipboard tunnel is down; copied via OSC 52 instead" >&2
