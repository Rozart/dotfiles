#!/usr/bin/env bash
# Records whether this machine's synced setups are current, into a cache file
# that the fish prompt reads. The prompt never runs git itself: a fish_prompt
# handler re-runs this in the background at most every 30 minutes.
#
# Cache holds either "✓" or space-separated markers:
#   cz⇣ / ai⇣  repo is behind origin, pull needed
#   cz✗ / ai✗  committed state is not applied on this machine
#
# Uncommitted and unpushed work deliberately does not count — this answers
# "is this machine current with what the others have", not "is my tree clean".

set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/sync-status"

mkdir -p "$(dirname "$CACHE")"

# Bumps the mtime the fish throttle reads before any slow work, so a hung fetch
# cannot make every subsequent prompt spawn another copy of this script.
touch "$CACHE"

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -oBatchMode=yes"

markers=""

mark() {
    markers="${markers:+$markers }$1"
}

is_behind() {
    local repo=$1 upstream count
    git -C "$repo" fetch --quiet 2>/dev/null
    upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) ||
        upstream="origin/$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null)"
    count=$(git -C "$repo" rev-list --count "HEAD..$upstream" 2>/dev/null) || return 1
    [ "${count:-0}" -gt 0 ]
}

if command -v chezmoi >/dev/null; then
    source_dir=$(chezmoi source-path 2>/dev/null) || source_dir=""
    if [ -n "$source_dir" ] && [ -d "$source_dir/.git" ]; then
        is_behind "$source_dir" && mark "cz⇣"
        [ -n "$(chezmoi status 2>/dev/null)" ] && mark "cz✗"
    fi
fi

ai_repo=""
for candidate in "$HOME/dev/ai-cli-configs" "$HOME/Dev/ai-cli-configs"; do
    if [ -d "$candidate/.git" ]; then
        ai_repo=$candidate
        break
    fi
done

if [ -n "$ai_repo" ] && command -v stow >/dev/null; then
    is_behind "$ai_repo" && mark "ai⇣"
    for pkg in "$ai_repo"/*/; do
        [ -d "$pkg" ] || continue
        pending=$(stow -n -v -d "$ai_repo" -t "$HOME" "$(basename "$pkg")" 2>&1 |
            grep -v '^WARNING: in simulation mode')
        if [ -n "$pending" ]; then
            mark "ai✗"
            break
        fi
    done
fi

tmp=$(mktemp "$CACHE.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n' "${markers:-✓}" >"$tmp"
mv "$tmp" "$CACHE"
