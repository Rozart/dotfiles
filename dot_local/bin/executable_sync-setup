#!/usr/bin/env bash
set -euo pipefail

echo "==> chezmoi: pull + apply"
chezmoi update

ai_repo=""
for candidate in "$HOME/dev/ai-cli-configs" "$HOME/Dev/ai-cli-configs"; do
    if [ -d "$candidate/.git" ]; then
        ai_repo=$candidate
        break
    fi
done

if [ -z "$ai_repo" ]; then
    echo "==> ai-cli-configs: repo not found, skipping" >&2
    exit 0
fi

echo "==> ai-cli-configs: pull + install ($ai_repo)"
git -C "$ai_repo" pull --ff-only
"$ai_repo/common/.agents/skills/setup/scripts/install.sh"
