# name: 'ANSI'
#
# Every colour here is an ANSI name, so the theme follows whatever palette
# ghostty is running — one file covers all eight slugs of the `theme` switcher.
# Only three variables name a literal background, and those are the three that
# have to differ: `white --background=brblack` is white-on-light-grey under the
# light themes, i.e. invisible. `-r` (reverse video) is palette-independent and
# correct everywhere, so the light variant uses it.
#
# fish picks the section matching $fish_terminal_color_theme and re-applies it
# whenever that changes, so `theme` itself never touches fish. [unknown] is for
# terminals that don't answer the background query; it takes the dark set.

[dark]
# preferred_background: 2c292f
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command blue
fish_color_comment red
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match white --background=brblack
fish_color_selection white --bold --background=brblack
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_completion normal
fish_pager_color_description yellow -i
fish_pager_color_prefix normal --bold --underline
fish_pager_color_progress brwhite --background=cyan
fish_pager_color_selected_background -r

[light]
# preferred_background: f9f2e9
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command blue
fish_color_comment red
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match -r
fish_color_selection -r --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_completion normal
fish_pager_color_description yellow -i
fish_pager_color_prefix normal --bold --underline
fish_pager_color_progress -r --bold
fish_pager_color_selected_background -r

[unknown]
fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command blue
fish_color_comment red
fish_color_cwd green
fish_color_cwd_root red
fish_color_end green
fish_color_error brred
fish_color_escape brcyan
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_normal normal
fish_color_operator brcyan
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection cyan --bold
fish_color_search_match -r
fish_color_selection -r --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_completion normal
fish_pager_color_description yellow -i
fish_pager_color_prefix normal --bold --underline
fish_pager_color_progress -r --bold
fish_pager_color_selected_background -r
