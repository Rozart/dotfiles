[Unit]
Description=Rex forwarded SSH agent relay

[Service]
Type=simple
ExecStart=/bin/sh {{ .chezmoi.homeDir }}/.config/rex/ssh-agent-start.sh
Environment=PATH={{ .chezmoi.homeDir }}/.local/bin:/usr/local/bin:/usr/bin:/bin
RuntimeDirectory=rex-ssh-agent
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0177
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
