-- Notes and tasks, both from the programium wiki-app via wikitui.nvim.
-- Supersedes telekasten (notes) and rozart.tasks (tasks); both kept at the bottom,
-- disabled, as a fallback.

local wiki_nvim = vim.fn.expand("~/Dev/wiki-app/apps/nvim")
-- This config is shared across machines; the wiki-app checkout is not.
local wiki_available = vim.fn.isdirectory(wiki_nvim .. "/lua/wikitui") == 1

return {
  {
    "folke/which-key.nvim",
    optional = true,
    opts = {
      spec = wiki_available and {
        { "<leader>z", group = "+wiki notes" },
        { "<leader>k", group = "+wiki tasks" },
      } or {},
    },
  },

  {
    dir = wiki_nvim,
    name = "wikitui.nvim",
    enabled = wiki_available,
    cmd = "Wiki",
    ft = "markdown",
    opts = {
      local_vault = { name = "private", path = "{{ .obsidian_base }}" },
      -- Notes created by following a [[link]] that doesn't exist yet.
      notes = { new_note_dir = "data/05_inbox" },
    },
    keys = {
      { "<leader>zf", "<cmd>Wiki find<cr>", desc = "Find notes" },
      { "<leader>zg", "<cmd>Wiki grep<cr>", desc = "Grep notes" },
      { "<leader>zd", "<cmd>Wiki today<cr>", desc = "Go to today" },
      { "<leader>zz", "<cmd>Wiki follow<cr>", desc = "Follow link" },
      { "<leader>zb", "<cmd>Wiki backlinks<cr>", desc = "Show backlinks" },
      { "<leader>zt", "<cmd>Wiki tags<cr>", desc = "Show tags" },
      { "<leader>zy", "<cmd>Wiki yank-link<cr>", desc = "Copy current note link" },
      { "<leader>zs", "<cmd>Wiki search<cr>", desc = "Search every vault" },
      { "<leader>zF", "<cmd>Wiki files<cr>", desc = "Browse server vault files" },

      { "<leader>kd", "<cmd>Wiki board<cr>", desc = "Task Dashboard (Eisenhower)" },
      { "<leader>kn", "<cmd>Wiki next<cr>", desc = "Do next" },
      { "<leader>kk", "<cmd>Wiki kanban<cr>", desc = "Team board" },
      { "<leader>ka", "<cmd>Wiki capture<cr>", desc = "Capture task" },
      { "<leader>kb", "<cmd>Wiki braindump<cr>", desc = "Capture braindump" },
      { "<leader>kj", "<cmd>Wiki journal<cr>", desc = "Capture journal" },
      { "<leader>ki", "<cmd>Wiki inbox<cr>", desc = "Braindump inbox" },
      { "<leader>ku", "<cmd>Wiki undo<cr>", desc = "Undo last task change" },
    },
  },

  -- [[note]], #tag and @name completion. The source's own enabled() is false outside
  -- vault notes, so it costs nothing in every other markdown buffer. Guarded inside the
  -- opts fn rather than with `enabled`, which would switch off blink itself.
  {
    "saghen/blink.cmp",
    optional = true,
    opts = function(_, opts)
      if not wiki_available then
        return
      end
      table.insert(opts.sources.default, "wiki")
      opts.sources.providers.wiki = {
        score_offset = 8,
        module = "wikitui.blink",
        name = "Wiki",
        async = true,
      }
    end,
  },

  -- The app uses two checkbox states beyond GFM.
  {
    "MeanderingProgrammer/render-markdown.nvim",
    opts = {
      checkbox = {
        custom = {
          in_progress = { raw = "[/]", rendered = "◐ ", highlight = "RenderMarkdownInfo" },
          cancelled = { raw = "[-]", rendered = "✘ ", highlight = "RenderMarkdownError" },
        },
      },
    },
  },

  -- Replaced by wikitui.nvim. Left here to re-enable if it misbehaves; the rozart
  -- modules stay requireable either way, since lua/ is already on the runtimepath.
  { "nvim-telekasten/telekasten.nvim", enabled = false },
  { dir = vim.fn.expand("~/.config/nvim/lua/rozart"), enabled = false },
}
