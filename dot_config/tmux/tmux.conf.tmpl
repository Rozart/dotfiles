set -g default-terminal "xterm-ghostty"
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'  # colored underscores
# true-color. terminal-FEATURES, not terminal-overrides: the overrides route is
# the pre-3.2 mechanism and tmux 3.7 no longer honours `*:RGB` there, so this
# silently did nothing and every colour fell back to the 256-colour cube.
set -as terminal-features ',*:RGB'

set -g prefix C-a
# Statusline theme follows ~/.config/theme (written by the `theme` fish function).
# run-shell, not `source -F`: #() in a format is async and returns empty on first
# evaluation, so source -F silently loads nothing. Verified on tmux 3.4.
run-shell "tmux source-file ~/.config/tmux/tmuxline/$(cat ~/.config/theme 2>/dev/null || echo sonokai-shusia).tmux.conf"

# start with window 1 (instead of 0)
set -g base-index 1

# start with pane 1
set -g pane-base-index 1
# don't rename windows automatically
set -g allow-rename off

# mouse control (clickable windows, panes, resizable panes)
set -g mouse on

set -g renumber-windows on
{{- if eq .chezmoi.os "darwin" }}
set -s copy-command 'pbcopy'
{{- else }}
# ssh-forwarded tunnel to the Mac's pbcopy server (see ~/.ssh/config on the
# Mac). clip-copy waits for the server's ack, falls back to OSC 52 when the
# tunnel is down, and notifies on the Mac once the copy has landed. Absolute
# path because copy-command's shell does not necessarily carry ~/.local/bin.
set -s copy-command '{{ .chezmoi.homeDir }}/.local/bin/clip-copy'
{{- end }}

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind c new-window -c "#{pane_current_path}"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

unbind-key -T copy-mode-vi v
unbind-key -T vi-copy v

bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle \; send -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel

# Use R to reload the config
unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display "Reloaded tmux config!"
set -sg escape-time 0
# -as, not -g: `set -g` REPLACES the whole override list, which silently wiped
# the RGB and Setulc entries set at the top of this file. Everything inside tmux
# then fell back to the 256-colour cube, so every theme rendered as its nearest
# xterm approximation rather than its actual hex.
set -as terminal-overrides ',*:smcup@:rmcup@'
setw -g aggressive-resize off


# enable vi mode keys
set-window-option -g mode-keys vi

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-copycat'
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @plugin 'sainnhe/tmux-net-speed'
set -g @plugin 'sainnhe/tmux-plugin-sysstat'
set -g @plugin 'sainnhe/tmux-fzf'

set -g @plugin 'toddyamakawa/tmux-scratchpad'
set -g @plugin 'christoomey/vim-tmux-navigator'

set -g history-limit 10000

# AI agent state badge (see ~/.local/bin/agent-state). Viewing a window clears a
# finished badge — that's what makes "done" mean "done and you haven't looked".
# `wait` and `busy` are left alone: they describe the present, not something unseen.
set-hook -g after-select-window 'run-shell -b "~/.local/bin/agent-state viewed #{window_id}"'

set -g @resurrect-strategy-vim 'session'
set -g @resurrect-strategy-nvim 'session'

set -g @continuum-restore 'on'

set -g @sysstat_cpu_view_tmpl '#[fg=magenta]CPU:#[default] #[fg=#{cpu.color}]#{cpu.pused}#[default]'
set -g @sysstat_mem_view_tmpl '#[fg=magenta]MEM:#[default: #[fg=#{mem.color}]#{mem.used}/#{mem.total}#[default]'
set -g status-interval 3
set -g @prefix_highlight_fg 'colour00'
set -g @prefix_highlight_bg 'red'
set -g @prefix_highlight_show_copy_mode 'on'
set -g @prefix_highlight_copy_mode_attr 'fg=colour00,bg=colour05,bold'
set -g @prefix_highlight_prefix_prompt 'PREFIX'
set -g @prefix_highlight_copy_prompt 'COPY'

TMUX_FZF_LAUNCH_KEY="C-Space"
set -g allow-passthrough on
set -s set-clipboard on
set -as terminal-features ",*:clipboard"

set -g update-environment "DISPLAY SSH_AUTH_SOCK SSH_ASKPASS SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY LC_DESKTOP_HOST"

# Run Tmux Plugin Manager
run '~/.tmux/plugins/tpm/tpm'
