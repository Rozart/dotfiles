[delta "sonokai-hikari"]
 blame-palette = "#f9f2e9 #f3eadd #ebe0d1 #e0d4c2 #d1c2ad"
 commit-decoration-style = "#6c5f6a" bold box ul
 light = true
 file-decoration-style = "#6c5f6a"
 file-style = "#4a3f48"
 hunk-header-decoration-style = "#6c5f6a" box ul
 hunk-header-file-style = bold
 hunk-header-line-number-style = bold "#6c5f6a"
 hunk-header-style = file line-number syntax
 line-numbers-left-style = "#6c5f6a"
 line-numbers-minus-style = bold "#ef2e62"
 line-numbers-plus-style = bold "#4ea919"
 line-numbers-right-style = "#6c5f6a"
 line-numbers-zero-style = "#6c5f6a"
 minus-emph-style = bold syntax "#f8b9c2"
 minus-style = syntax "#f9dcda"
 plus-emph-style = bold syntax "#cceeaa"
 plus-style = syntax "#e5f0cd"
 map-styles = \
 	bold purple => syntax "#5624ed", \
 	bold blue => syntax "#0d7f9b", \
 	bold cyan => syntax "#0d7f9b", \
 	bold yellow => syntax "#d08d06"
 # Should match the name of the bat theme
 syntax-theme = Monokai Extended Light
