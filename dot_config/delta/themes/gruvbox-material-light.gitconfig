[delta "gruvbox-material-light"]
 blame-palette = "#fbf1c7 #f4e8be #eee0b7 #e6d8ad #ddccab"
 commit-decoration-style = "#7c6f64" bold box ul
 light = true
 file-decoration-style = "#7c6f64"
 file-style = "#654735"
 hunk-header-decoration-style = "#7c6f64" box ul
 hunk-header-file-style = bold
 hunk-header-line-number-style = bold "#7c6f64"
 hunk-header-style = file line-number syntax
 line-numbers-left-style = "#7c6f64"
 line-numbers-minus-style = bold "#c14a4a"
 line-numbers-plus-style = bold "#6c782e"
 line-numbers-right-style = "#7c6f64"
 line-numbers-zero-style = "#7c6f64"
 minus-emph-style = bold syntax "#f0c7ae"
 minus-style = syntax "#f7dcc4"
 plus-emph-style = bold syntax "#dcdc9e"
 plus-style = syntax "#e8e3bc"
 map-styles = \
 	bold purple => syntax "#945e80", \
 	bold blue => syntax "#45707a", \
 	bold cyan => syntax "#4c7a5d", \
 	bold yellow => syntax "#b47109"
 # Should match the name of the bat theme
 syntax-theme = gruvbox-light
