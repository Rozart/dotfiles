[delta "gruvbox-material-dark"]
 blame-palette = "#282828 #32302f #3c3836 #45403d #5a524c"
 commit-decoration-style = "#a89984" bold box ul
 dark = true
 file-decoration-style = "#a89984"
 file-style = "#d4be98"
 hunk-header-decoration-style = "#a89984" box ul
 hunk-header-file-style = bold
 hunk-header-line-number-style = bold "#7c6f64"
 hunk-header-style = file line-number syntax
 line-numbers-left-style = "#a89984"
 line-numbers-minus-style = bold "#ea6962"
 line-numbers-plus-style = bold "#a9b665"
 line-numbers-right-style = "#a89984"
 line-numbers-zero-style = "#a89984"
 minus-emph-style = bold syntax "#4c3432"
 minus-style = syntax "#3c2f2c"
 plus-emph-style = bold syntax "#4a4b23"
 plus-style = syntax "#34381b"
 map-styles = \
 	bold purple => syntax "#d3869b", \
 	bold blue => syntax "#7daea3", \
 	bold cyan => syntax "#89b482", \
 	bold yellow => syntax "#d8a657"
 # Should match the name of the bat theme
 syntax-theme = gruvbox-dark
