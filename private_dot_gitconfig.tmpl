[color]
	diff = true
	status = true
	ui = true
  interactive = true
  branch = true
[core]
  autocrlf = input
	editor = nvim
	pager = delta
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
{{ if (stat "/opt/1Password/op-ssh-sign") }}
    program = "/opt/1Password/op-ssh-sign"
{{ else if (stat "/Applications/1Password.app/Contents/MacOS/op-ssh-sign") }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{ end }}
[mergetool]
	hideResolved = true
[commit]
	gpgsign = true
	verbose = true
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/delta.config
[delta]
	navigate = true
	hyperlinks = true
[pretty]
	# Aligned table for `git lg`. Only %an is padded — %h and %as are already
	# fixed-width, and padding the LAST column (%s) would both truncate long
	# subjects and leave trailing whitespace on every line, breaking copy-paste
	# and `git lg | grep`.
	# %<(N,trunc) pads by display column, so multibyte names (Różalski) stay in line.
	# No --graph here: a merge prefix is 2 cols on a plain commit but 4 on a merge,
	# which skews every column after it.
	# tblp is the `lg` default. %H%x01 prefixes each line and %x02 marks the
	# symbol slot; git-lg strips both and fills the slot with signature PRESENCE
	# (? signed / · unsigned) read from one `git cat-file --batch` stream. No
	# verification happens, so it costs ~nothing even on a fully signed history.
	tblp = "%H%x01%C(auto)%h%C(reset) %x02 %C(blue)%as%C(reset) %C(green)%<(14,trunc)%an%C(reset) %s%C(auto)%d"
	# tbl is the verifying variant behind `git lgs`. %G? shells out to
	# ssh-keygen/gpg once per SIGNED commit (~10ms each — minutes over a big
	# signed history, which is why it is no longer the `lg` default). Left raw
	# and uncoloured on purpose: git-lg turns the letter into a coloured symbol,
	# which a pretty format cannot do since git log has no conditionals. Using
	# --pretty=tbl directly still works and just shows git's raw letter.
	# Needs gpg.ssh.allowedSignersFile set or every commit reports E.
	tbl = "%C(auto)%h%C(reset) %G? %C(blue)%as%C(reset) %C(green)%<(14,trunc)%an%C(reset) %s%C(auto)%d"
	# Free-flowing, for when topology matters more than scanning.
	# Never add -p to the graph aliases: the graph prefix on diff lines defeats
	# delta's parser and it silently falls back to git's own colours.
	gph = "%C(auto)%h %C(blue)%as%C(reset) %C(green)%an%C(reset) %s%C(auto)%d"
[pager]
	# `!` aliases are not paged by default; this restores it, and tells git-lg it
	# may still emit colour even though its stdout is now a pipe.
	lg = true
	lgs = true
[alias]
	lg = "!git-lg"
	lgs = "!git-lg --verify"
	lgg = log --graph --pretty=gph
	lga = log --graph --pretty=gph --all
	last = log -1 --stat
	st = status --short
	ss = status
[column]
	# auto, not always: disables itself when piped, so nothing that parses
	# git output breaks.
	ui = auto
[status]
	showStash = true
	branch = true
[rebase]
	autosquash = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = default
	# Cleaner than the default myers on repetitive/structured code.
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
# The host prefix is an ~/.ssh/config alias, so the remote reads
# `<alias>:owner/repo.git`. Pattern must be `:*/**`, not `:*` — this glob is
# pathname-style, so a bare `*` stops at the first `/` and never matches a real
# remote. `**` is only special as a whole path component, so `:**` fails too:
# `*` takes the owner, `/**` takes the rest at any depth.
[includeIf "hasconfig:remote.*.url:workgit:*/**"]
	path = "~/.config/git/.gitconfig_work"
[includeIf "hasconfig:remote.*.url:personalgit:*/**"]
	path = "~/.config/git/.gitconfig_private"
[includeIf "hasconfig:remote.*.url:programiumgit:*/**"]
	path = "~/.config/git/.gitconfig_programium"
[includeIf "hasconfig:remote.*.url:homelabgit:*/**"]
	path = "~/.config/git/.gitconfig_homelab"
